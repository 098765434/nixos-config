// niri config, ported from ~/.config/niri/config.kdl on Arch.
//
// Managed by home-manager (see home/home.nix): this is the source; it's placed
// at ~/.config/niri/config.kdl as a read-only symlink. Edit THIS file, then
// `nixos-rebuild switch`. Validate with: niri validate ~/.config/niri/config.kdl
//
// A few host-specific lines are disabled with KDL's "/-" node-comment and
// marked NIXOS-NOTE.

prefer-no-csd

// Global blur backend tune. The `background-effect { blur true }` block
// inside layer/window rules enables blur per-surface; this section
// controls the shared dual-Kawase pipeline.
blur {
    passes 1
    offset 1
    noise 0.02
    saturation 1.3
}

input {
    keyboard {
        xkb {
            // Empty: niri fetches xkb from org.freedesktop.locale1,
            // which NixOS drives via services.xserver.xkb (layout "no").
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {}
    trackpoint {}
}

// NIXOS-NOTE: this output block targets your real OLED laptop panel. In a VM
// the virtual display has a different name, so niri ignores this block thericone.
// After first boot, run `niri msg outputs` to confirm the name.
output "eDP-1" {
    mode "2880x1800@120.000"
    scale 1.75
    transform "normal"
    variable-refresh-rate on-demand=true
}

layout {
    empty-workspace-above-first
    gaps 0
    // Transparent so the backdrop wallpaper (layer-rule below) shows through.
    background-color "transparent"
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    focus-ring {
        off
        width 2
        active-color "#7fc8ff"
        inactive-color "#505050"
    }
    border {
        //off
        width 4
        active-color "#000"
        inactive-color "#000"
        urgent-color "#9b0000"
    }
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    struts {
        //bottom -4
        //top  -4
    }
}

overview {
    backdrop-color "#000000"
    workspace-shadow {
        off
    }
}

// Move the swaybg wallpaper (home.nix) into the backdrop, so it also shows
// behind the overview. It stays put while workspaces slide over it.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}

// --- Autostart ---------------------------------------------------------------
// NIXOS-NOTE: your custom amane shell/launcher is built in your home dir, not
// yet packaged for NixOS, so this spawn is disabled. Re-enable once packaged.
/-spawn-at-startup "amane" "run"

// NOTE: hypridle (idle) and the amane-shell bar (which is also the notification
// daemon) are run as home-manager user services (see home/home.nix), so they're
// NOT spawned here.

// Status bar. Replaced by the amane status bar (components/status_bar); waybar is
// disabled so the two don't both reserve the bottom edge. Re-enable by
// removing the `/-` if you want waybar back.
/-spawn-at-startup "waybar"

// Network tray applet.
spawn-at-startup "nm-applet" "--indicator"

// Clipboard history: record copies so cliphist can recall them (bind below).
spawn-sh-at-startup "wl-paste --watch cliphist store"

hotkey-overlay {
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

animations {
}

// --- Window rules ------------------------------------------------------------
window-rule {
    // Zen (Firefox-based) picture-in-picture player floats by default.
    match app-id=r#"^app\.zen_browser\.zen$"# title="^Picture-in-Picture$"
    open-floating true
    
}

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
    
}

// >>> amane layer-rules (generated from shell/niri-layer-rule.kdl — do not edit by hand)
// Status bar: one uniform frosted strip along the bottom, macOS 27's toolbar:
// frost, the standard material without a lens. It reserves its zone, so only
// the wallpaper is behind it and niri's xray blur is enough. Its xdg-popups
// (tooltips, Do Not Disturb's menu) are frosted cards.
layer-rule {
    match namespace="^amane\\.status-bar$"
    geometry-corner-radius 0
    background-effect {
        blur true
        material "frost"
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Context menu. The anchor is an invisible 1×1 layer-surface; the visible
// cards (menu + nested submenus) are xdg-popups of it, so the `popups {}`
// block styles every level uniformly. Namespaces: the anchor is
// `amane.context-menu-anchor`; each depth level is `amane.context-menu.0`..`7`.
layer-rule {
    match namespace="^amane\\.context-menu-anchor$"

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Quick Settings: a clear surface whose modules are frosted one by one, the
// surface saying where (ext-background-effect). Toggled by the status bar's
// Quick Settings button. A Bluetooth device's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.quick-settings$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Dock: a clear surface over the bar, one a monitor, whose card is frosted
// where the surface says (ext-background-effect). It comes up from the
// bottom edge; a window's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.dock$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Launcher: a clear surface over the output whose glass panel, in the middle,
// is frosted where the surface says (ext-background-effect). Toggled over IPC
// from a keybind. An app's menu is an xdg-popup of it.
layer-rule {
    match namespace="^amane\\.launcher$"
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// Notification toasts: one surface per banner, sized to its card, sliding in
// at the top-right. Each frosts its card itself (blur shapes, in the glass
// material); the rule rounds it and gives it niri's shadow.
layer-rule {
    match namespace="^amane\\.notifications\\.toast$"
    geometry-corner-radius 16
    shadow {
        on
        softness 16
        offset x=0 y=8
        color "#00000073"
    }
    background-effect {
        xray false
    }
}

// Notification center: a full-height glass sidebar at the right edge, opened
// from the clock, frosting itself (blur shapes, in the glass material); the
// rule rounds it and gives it niri's shadow. Its Do Not Disturb menu is an
// xdg-popup of it.
layer-rule {
    match namespace="^amane\\.notifications\\.center$"
    geometry-corner-radius 26
    shadow {
        on
        softness 16
        offset x=0 y=8
        color "#00000073"
    }
    background-effect {
        xray false
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// An amane app's windows: frosted behind, the window drawing its own tint
// over the frost (the window material), and its popups like the shell's.
window-rule {
    match app-id="^amane-settings$"
    background-effect {
        blur true
        material "frost"
    }

    popups {
        geometry-corner-radius 10
        background-effect {
            blur true
            material "glass"
        }
    }
}

// The shell's materials (material.* tokens), by the names it asks for: liquid
// glass, its clear variant for media, and frost without a lens; each `-still`
// twin is for reduced motion. They replace a hand-written `materials {}` of
// the same names. See the niri fork's docs/wiki/Window-Effects.md.
materials {
    material "frost" {
        bevel 8
        dispersion 0
        far-rim 0
        refraction 0
        rim 0.12
        specular 0
        tint 1
    }
    material "glass" {
        adaptive-tint 0.6
        bevel 30
        dispersion 0.6
        far-rim 0.15
        refraction 24
        report-backdrop true
        rim 0.25
        specular 0.15
        tint 1
    }
    material "glass-clear" {
        bevel 30
        dispersion 0.8
        far-rim 0.2
        refraction 32
        report-backdrop true
        rim 0.3
        specular 0.25
        tint 1
    }
    material "frost-still" {
        bevel 8
        dispersion 0
        far-rim 0
        refraction 0
        rim 0.12
        specular 0
        tint 1
        materialize false
    }
    material "glass-still" {
        adaptive-tint 0.6
        bevel 30
        dispersion 0.6
        far-rim 0.15
        refraction 24
        report-backdrop true
        rim 0.25
        specular 0.15
        tint 1
        materialize false
    }
    material "glass-clear-still" {
        bevel 30
        dispersion 0.8
        far-rim 0.2
        refraction 32
        report-backdrop true
        rim 0.3
        specular 0.25
        tint 1
        materialize false
    }
}
// <<< amane layer-rules

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Terminal = foot, launcher = wofi (matched to your Arch binds).
    Mod+Return hotkey-overlay-title="Open a Terminal: foot" { spawn "foot"; }
    Mod+T hotkey-overlay-title="Open a Terminal: foot" { spawn "foot"; }
    Mod+D hotkey-overlay-title="Run an Application: wofi" { spawn "wofi" "--show" "drun"; }
    // the amane-shell launcher, toggled over the shell's IPC socket
    Mod+Space hotkey-overlay-title="App Launcher: amane" { spawn "sh" "-c" "printf 'launcher\\ntoggle\\n' | nc -U -N $XDG_RUNTIME_DIR/amane.sock"; }
    // through logind, so hypridle starts swaylock and the shell sees the lock
    // (Keep Awake lets the screen blank while locked)
    Super+Alt+L hotkey-overlay-title="Lock the Screen: swaylock" { spawn "loginctl" "lock-session"; }

    // Clipboard history picker (cliphist + wofi).
    Mod+Ctrl+V hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | wofi --dmenu | cliphist decode | wl-copy"; }

    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }

    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // Amane context menu: arm the fullscreen hit-catcher, then right-click
    // anywhere to open the menu (or Esc / left-click to cancel).
    Mod+Shift+M hotkey-overlay-title="Arm Context Menu" { spawn-sh "printf 'arm\\n' | nc -U -N $XDG_RUNTIME_DIR/amane.sock"; }

    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+J     { move-window-down; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+L     { move-column-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-down; }
    Mod+I              { focus-workspace-up; }
    Mod+Ctrl+Page_Down { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-column-to-workspace-up; }
    Mod+Ctrl+U         { move-column-to-workspace-down; }
    Mod+Ctrl+I         { move-column-to-workspace-up; }

    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }
    Mod+Shift+U         { move-workspace-down; }
    Mod+Shift+I         { move-workspace-up; }

    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R { reset-window-height; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+M { maximize-column; }
    Mod+Ctrl+F { expand-column-to-available-width; }

    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+V       { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    Mod+Shift+P { power-off-monitors; }
}

// The materials (glass, glass-clear, frost and their -still twins) are generated
// from amane-shell's tokens, in the amane layer-rules region above.
